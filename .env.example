# Frontend build vars (GitHub Pages)
VITE_BASE_PATH=/<repo-name>/
VITE_API_BASE_URL=https://your-backend-domain.com
VITE_BASEROW_API_URL=https://api.baserow.io/api/database/rows/table
# GitHub Pages: configure BASEROW_TOKEN in Actions Variables. Do not commit it here.
VITE_BASEROW_TOKEN=

# Backend runtime vars (Render/Railway/Fly)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# IMPORTANT: origin only, no path. Example: https://tqdaoinfo108.github.io
CORS_ORIGIN=https://your-github-username.github.io
